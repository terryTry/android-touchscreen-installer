{
  "name": "android-touchscreen-installer",
  "version": "0.3.0-rc.1",
  "description": "面向现场安装人员的安卓触摸屏 ADB 安装助手",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "node scripts/postinstall.mjs",
    "test:e2e": "npm run typecheck:e2e && playwright test",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --pretty",
    "test:e2e:serve": "vite --config tests/e2e/vite.config.ts",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@devicefarmer/adbkit-apkreader": "3.2.4",
    "@h-t-m/app-inspect": "0.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "execa": "10.0.0",
    "lucide-react": "1.27.0",
    "p-queue": "9.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shell-quote": "1.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/shell-quote": "1.7.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "27.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "org.androidtouchscreeninstaller.desktop",
    "productName": "安卓触摸屏安装助手",
    "asar": true,
    "asarUnpack": [
      "node_modules/@h-t-m/app-inspect/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/platform-tools/windows",
        "to": "platform-tools/windows",
        "filter": [
          "adb.exe",
          "AdbWinApi.dll",
          "AdbWinUsbApi.dll",
          "NOTICE.txt",
          "source.properties"
        ]
      },
      {
        "from": "resources/drivers",
        "to": "drivers",
        "filter": [
          "**/*",
          "!README.md"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "android-touchscreen-installer-${version}-win-x64.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "安卓触摸屏安装助手",
      "deleteAppDataOnUninstall": false
    }
  }
}
